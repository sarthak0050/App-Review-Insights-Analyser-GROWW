# Copy to `.env` and fill in. `.env` is ignored by git.
# Values are read from the environment at runtime.

# Gemini API key (optional). Enables live note/email generation in the local
# dashboard server -> scripts/serve_dashboard.py. Without it, all generation
# uses the deterministic keyless fallback (same as the hosted Vercel app).
# Get a free key at https://aistudio.google.com/ (no card needed).
GEMINI_API_KEY=

# Gemini model used for the weekly note + email draft.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional SMTP credentials for the dashboard's "Send email" button.
# Only needed if you send drafts directly over SMTP; the mailto / .eml /
# output/email_draft.html paths need no credentials.
# SMTP_EMAIL=
# SMTP_APP_PASSWORD=